        var target = document.querySelector('.form_container') || 
                     document.querySelector('#sp_formcontainer') || 
                     document.querySelector('.tab-content') ||
                     document.body;
        
        if (target) {
            // 使用 createElement 和 appendChild 更安全的方式
            var tempDiv = document.createElement('div');
            tempDiv.innerHTML = searchHTML;
            target.appendChild(tempDiv);
        }
    }, 1000);
}

// 搜索函数
function performCaseSearch() {
    var keyword = document.getElementById('caseSearchInput').value;
    if (!keyword || keyword.length < 2) {
        document.getElementById('caseSearchResults').innerHTML = '<p class="text-muted">请输入关键词搜索 CaseDemo 记录</p>';
        return;
    }

    var ga = new GlideAjax('CaseDemoUtils');
    ga.addParam('sysparm_name', 'searchCaseDemoRecords');
    ga.addParam('sysparm_keyword', keyword);
    ga.getXML(handleCaseSearchResponse);
}

function handleCaseSearchResponse(response) {
    var answer = response.responseXML.documentElement.getAttribute("answer");
    var results = JSON.parse(answer);
    var resultsHtml = '';

    if (results.length > 0) {
        resultsHtml = '<div class="list-group" style="max-height: 300px; overflow-y: auto;">';
        for (var i = 0; i < results.length; i++) {
            var item = results[i];
            resultsHtml += '<a href="' + currentTableName + '.do?sys_id=' + item.sys_id + '" class="list-group-item" target="_blank">';
            resultsHtml += '<strong>' + item.number + '</strong>: ' + (item.short_description || '无描述');
            resultsHtml += '</a>';
        }
        resultsHtml += '</div>';
    } else {
        resultsHtml = '<p class="text-warning">未找到匹配的记录。</p>';
    }

    document.getElementById('caseSearchResults').innerHTML = resultsHtml;
}

