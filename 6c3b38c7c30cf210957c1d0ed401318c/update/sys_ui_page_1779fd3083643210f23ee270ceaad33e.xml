<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description/>
        <direct>false</direct>
        <endpoint>x_1108048_wish_l_0_casedemo_list_with_search.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  
  <!-- 上部：检索区域 -->
  <div class="panel panel-default" style="margin-bottom: 20px;">
    <div class="panel-heading">
      <h3 class="panel-title">]]>🔍<![CDATA[ CaseDemo 记录检索</h3>
    </div>
    <div class="panel-body">
      <div class="form-group">
        <input 
          type="text" 
          class="form-control" 
          id="moduleSearchInput" 
          placeholder="搜索 CaseDemo 记录..." 
          onkeyup="performModuleSearch(this.value)"
          style="max-width: 400px; display: inline-block; margin-right: 10px;"
        />
        <button class="btn btn-primary" onclick="performModuleSearch(document.getElementById('moduleSearchInput').value)">搜索</button>
      </div>
      
      <!-- 检索结果 -->
      <div id="moduleSearchResults">
        <p class="text-muted">请输入关键词搜索，或查看下方完整列表</p>
      </div>
    </div>
  </div>

  <!-- 下部：标准列表 -->
  <div class="panel panel-default">
    <div class="panel-heading">
      <h3 class="panel-title">]]>📋<![CDATA[ 所有 CaseDemo 记录</h3>
    </div>
    <div class="panel-body" style="padding: 0;">
      <!-- 嵌入标准列表 -->
      <iframe 
        src="x_1108048_wish_l_0_democase_list.do" 
        style="width: 100%; height: 600px; border: none;"
        frameborder="0"
        id="listFrame"
      ></iframe>
    </div>
  </div>

  <script>
    function performModuleSearch(keyword) {
      if (!keyword || keyword.length &lt; 2) {
        document.getElementById('moduleSearchResults').innerHTML = '&lt;p class="text-muted"&gt;请输入关键词搜索，或查看下方完整列表&lt;/p&gt;';
        return;
      }

      var ga = new GlideAjax('CaseDemoUtils');
      ga.addParam('sysparm_name', 'searchCaseDemoRecords');
      ga.addParam('sysparm_keyword', keyword);
      ga.getXML(handleModuleSearchResponse);
    }

    function handleModuleSearchResponse(response) {
      var answer = response.responseXML.documentElement.getAttribute("answer");
      var results = JSON.parse(answer);
      var resultsHtml = '';

      if (results.length &gt; 0) {
        resultsHtml += '&lt;div class="search-results-container"&gt;';
        resultsHtml += '&lt;p class="text-success"&gt;&lt;strong&gt;找到 ' + results.length + ' 条结果:&lt;/strong&gt;&lt;/p&gt;';
        resultsHtml += '&lt;div class="list-group"&gt;';
        
        for (var i = 0; i &lt; results.length; i++) {
          var item = results[i];
          resultsHtml += '&lt;a href="x_company_casedemo.do?sys_id=' + item.sys_id + '" class="list-group-item list-group-item-action"&gt;';
          resultsHtml += '&lt;div class="d-flex w-100 justify-content-between"&gt;';
          resultsHtml += '&lt;h5 class="mb-1"&gt;' + item.number + '&lt;/h5&gt;';
          resultsHtml += '&lt;small&gt;点击查看详情&lt;/small&gt;';
          resultsHtml += '&lt;/div&gt;';
          resultsHtml += '&lt;p class="mb-1"&gt;' + (item.short_description || '无描述') + '&lt;/p&gt;';
          resultsHtml += '&lt;small&gt;状态: ' + (item.state || 'N/A') + '&lt;/small&gt;';
          resultsHtml += '&lt;/a&gt;';
        }
        
        resultsHtml += '&lt;/div&gt;&lt;/div&gt;';
      } else {
        resultsHtml = '&lt;p class="text-warning"&gt;未找到匹配的 CaseDemo 记录。&lt;/p&gt;';
      }

      document.getElementById('moduleSearchResults').innerHTML = resultsHtml;
    }
  </script>

  <style>
    .search-results-container {
      max-height: 400px;
      overflow-y: auto;
      margin-top: 15px;
    }
  </style>
</j:jelly>]]></html>
